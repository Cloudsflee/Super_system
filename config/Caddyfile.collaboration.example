{$AIWS_WEB_DOMAIN} {
  @outside_private_network not remote_ip private_ranges 100.64.0.0/10
  respond @outside_private_network "team_web_auth_required" 403
  encode zstd gzip
  reverse_proxy 127.0.0.1:4317
}

{$AIWS_MCP_DOMAIN} {
  @mcp path /mcp
  reverse_proxy @mcp 127.0.0.1:4319 {
    flush_interval -1
  }
  respond 404
}
