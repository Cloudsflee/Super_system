+function cleanConfig(root) {
+  return { runtime: 'v3-clean', apiVersion: '2', host: '127.0.0.1', port: 0, home: root, databaseFile: path.join(root, 'data', 'state.sqlite'), casRoot: path.join(root, 'cas'), receiptRoot: path.join(root, 'receipts'), cursorSecret: 'integration-cursor', runtimeBuild: 'integration', maxBodyBytes: 100000 };
+}
