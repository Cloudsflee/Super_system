diff --git a/apps/api/src/clean/platform-error.mjs b/apps/api/src/clean/platform-error.mjs
new file mode 100644
index 0000000..49c4b3d
--- /dev/null
+++ b/apps/api/src/clean/platform-error.mjs
@@ -0,0 +1,10 @@
+export class PlatformError extends Error {
+  constructor(code, message, details = {}, status = 409) {
+    super(message);
+    this.name = 'PlatformError';
+    this.code = code;
+    this.status = status;
+    this.retryable = code === 'revision_conflict' || code === 'idempotency_conflict';
+    this.details = details;
+  }
+}

diff --git a/apps/api/src/clean/platform.mjs b/apps/api/src/clean/platform.mjs
