diff --git a/scripts/v3-clean-architecture-scan.mjs b/scripts/v3-clean-architecture-scan.mjs
new file mode 100644
index 0000000..ed3c6ac
--- /dev/null
+++ b/scripts/v3-clean-architecture-scan.mjs
@@ -0,0 +1,57 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const cleanRoot = path.join(root, 'apps', 'api', 'src', 'clean');
+const entrypoints = [path.join(root, 'apps', 'api', 'server.mjs'), path.join(root, 'apps', 'api', 'clean-server.mjs'), path.join(root, 'apps', 'api', 'server-clean.mjs')];
+const forbidden = [
+  { pattern: /legacy_compat|native_v5|native_v6|ASSIST_NATIVE_V6/i, label: 'legacy runtime switch' },
+  { pattern: /assist_operations/i, label: 'second operation ledger' },
+  { pattern: /(?:^|[\\/])(?:src[\\/])?migrations[\\/](?:00[2-9]|0[1-9][0-9])/i, label: 'historical migration import' },
+  { pattern: /(?:^|[\\/])apps[\\/](?:worker|mcp-gateway)(?:[\\/]|$)/i, label: 'historical service import' }
+];
+
+const visited = new Set();
+const files = [];
+const findings = [];
+
+for (const entry of entrypoints) visit(entry);
+
+const tableText = files.map((file) => fs.readFileSync(file, 'utf8')).join('\n');
+if (/CREATE\s+TABLE[^;]*\b(?:assist|project|workflow|execution|domain)_heads\b/i.test(tableText)) findings.push({ label: 'shadow head model', file: 'clean schema' });
+if (/CREATE\s+TABLE[^;]*\bassist_operations\b/i.test(tableText)) findings.push({ label: 'second operation ledger', file: 'clean schema' });
+
+const result = {
+  schema_version: 'aiws.v3-clean.architecture-scan.v1',
+  entrypoints: entrypoints.map((file) => relative(file)),
+  files: files.map(relative),
+  forbidden_findings: findings,
+  valid: findings.length === 0
+};
+process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
+if (!result.valid) process.exitCode = 1;
+
+function visit(file) {
+  const resolved = resolveFile(file);
+  if (!resolved || visited.has(resolved)) return;
+  visited.add(resolved);
+  files.push(resolved);
+  const content = fs.readFileSync(resolved, 'utf8');
+  for (const item of forbidden) if (item.pattern.test(content)) findings.push({ label: item.label, file: relative(resolved) });
+  const imports = [...content.matchAll(/(?:import|export)\s+(?:[^'";]+?\s+from\s+)?['"](\.[^'"]+)['"]/g)].map((match) => match[1]);
+  for (const specifier of imports) {
+    const target = path.resolve(path.dirname(resolved), specifier);
+    if (!target.startsWith(cleanRoot + path.sep) && !entrypoints.includes(resolveFile(target))) findings.push({ label: 'clean entry leaves clean module boundary', file: relative(resolved), target: specifier });
+    else visit(target);
+  }
+}
+
+function resolveFile(file) {
+  const candidates = [file, `${file}.mjs`, `${file}.js`, path.join(file, 'index.mjs')];
+  return candidates.find((candidate) => fs.existsSync(candidate) && fs.statSync(candidate).isFile()) || null;
+}
+
+function relative(file) {
+  return path.relative(root, file).replaceAll('\\', '/');
+}

