diff --git a/apps/api/src/clean/redaction.mjs b/apps/api/src/clean/redaction.mjs
new file mode 100644
index 0000000..09df8fa
--- /dev/null
+++ b/apps/api/src/clean/redaction.mjs
@@ -0,0 +1,113 @@
+import { canonicalize, canonicalJson, sha256Ref } from './canonical.mjs';
+
+const SENSITIVE_KEY = /(?:^|_)(?:secret|token|password|passwd|cookie|authorization|api[_-]?key|private[_-]?key|credential|prompt|full[_-]?prompt|parser_text|parser_output|extracted_text|raw_text)(?:$|_)/i;
+const BEARER = /\bBearer\s+[A-Za-z0-9._~+/=-]{8,}/gi;
+const KEY_TOKEN = /\b(?:sk|rk|key|token|ghp|gho|xox[baprs])-?[A-Za-z0-9_-]{8,}\b/gi;
+const WINDOWS_PATH = /\b[A-Za-z]:\\[^\r\n\t"']{2,}\b/g;
+const POSIX_PATH = /(^|[\s(])\/(?!\/)[^\r\n\t"']{2,}/g;
+
+export class RedactionError extends Error {
+  constructor(message, details = {}) {
+    super(message);
+    this.name = 'RedactionError';
+    this.code = 'redaction_blocked';
+    this.details = details;
+  }
+}
+
+export class RedactionPolicy {
+  constructor(options = {}) {
+    this.maxString = Number.isInteger(options.maxString) ? options.maxString : 4000;
+    this.maxArray = Number.isInteger(options.maxArray) ? options.maxArray : 500;
+    this.maxObject = Number.isInteger(options.maxObject) ? options.maxObject : 200;
+  }
+
+  redact(value) {
+    const findings = [];
+    const output = this.#walk(value, '$', findings, false);
+    return { value: output, redactions: findings };
+  }
+
+  redactObject(value) {
+    return this.redact(value).value;
+  }
+
+  scan(value) {
+    const result = this.redact(value);
+    return {
+      safe: result.redactions.length === 0,
+      redactions: result.redactions,
+      redacted: result.value,
+      payload_sha256: sha256Ref(canonicalJson(result.value))
+    };
+  }
+
+  assertSafe(value, options = {}) {
+    const result = this.scan(value);
+    if (!result.safe) {
+      throw new RedactionError(options.message || 'payload contains a restricted value', {
+        ...result,
+        receipt_status: 'redacted_failure'
+      });
+    }
+    return result.redacted;
+  }
+
+  #walk(value, path, findings, sensitiveParent) {
+    if (typeof value === 'string') return this.#string(value, path, findings, sensitiveParent);
+    if (value === null || typeof value === 'number' || typeof value === 'boolean') return value;
+    if (Array.isArray(value)) {
+      return value.slice(0, this.maxArray).map((item, index) => this.#walk(item, `${path}[${index}]`, findings, sensitiveParent));
+    }
+    if (value && typeof value === 'object') {
+      const output = {};
+      for (const key of Object.keys(value).slice(0, this.maxObject)) {
+        if (value[key] === undefined) continue;
+        const sensitive = sensitiveParent || isSensitiveKey(key);
+        if (sensitive) {
+          findings.push({ path: `${path}.${key}`, reason: 'restricted_field' });
+          output[key] = '[redacted]';
+        } else {
+          output[key] = this.#walk(value[key], `${path}.${key}`, findings, false);
+        }
+      }
+      return output;
+    }
+    findings.push({ path, reason: 'unsupported_value' });
+    return '[redacted]';
+  }
+
+  #string(value, path, findings, sensitive) {
+    if (sensitive) return '[redacted]';
+    let output = String(value);
+    if (output.length > this.maxString) {
+      findings.push({ path, reason: 'bounded_length' });
+      output = `${output.slice(0, this.maxString)}...[truncated]`;
+    }
+    const before = output;
+    output = output.replace(BEARER, 'Bearer [redacted]').replace(KEY_TOKEN, '[redacted]');
+    output = output.replace(WINDOWS_PATH, '[redacted-path]');
+    output = output.replace(POSIX_PATH, '$1[redacted-path]');
+    if (output !== before) findings.push({ path, reason: 'restricted_text' });
+    return output;
+  }
+}
+
+function isSensitiveKey(key) {
+  const normalized = String(key).replace(/[A-Z]/g, (letter) => `_${letter.toLowerCase()}`);
+  return SENSITIVE_KEY.test(normalized);
+}
+
+export const DEFAULT_REDACTION_POLICY = Object.freeze(new RedactionPolicy());
+
+export function redact(value, policy = DEFAULT_REDACTION_POLICY) {
+  return policy.redact(value);
+}
+
+export function redactObject(value, policy = DEFAULT_REDACTION_POLICY) {
+  return policy.redactObject(value);
+}
+
+export function scanRedactions(value, policy = DEFAULT_REDACTION_POLICY) {
+  return policy.scan(value);
+}

diff --git a/apps/api/src/clean/registry.mjs b/apps/api/src/clean/registry.mjs
new file mode 100644
index 0000000..66db4fb
--- /dev/null
+++ b/apps/api/src/clean/registry.mjs
@@ -0,0 +1,126 @@
+const entries = [
+  {
+    command_id: 'operations.get',
+    version: 2,
+    method: 'GET',
+    path: '/api/v2/operations/{id}',
+    owner: 'Operations',
+    scope: 'operations:read',
+    project_scoped: true,
+    idempotency: 'forbidden',
+    expected_revision: 'none',
+    input_schema: 'operation.id.v2',
+    output_schema: 'operation.receipt.v2',
+    long_running: false,
+    events: ['operation.*'],
+    mcp: { mapping: 'resource', name: 'operation_get' }
+  },
+  {
+    command_id: 'operations.events',
+    version: 2,
+    method: 'GET',
+    path: '/api/v2/operations/{id}/events',
+    owner: 'Operations',
+    scope: 'operations:read',
+    project_scoped: true,
+    idempotency: 'forbidden',
+    expected_revision: 'none',
+    input_schema: 'operation.events.query.v2',
+    output_schema: 'event.replay.v2',
+    long_running: false,
+    events: ['operation.*'],
+    mcp: { mapping: 'resource', name: 'operation_events' }
+  },
+  {
+    command_id: 'operations.cancel',
+    version: 2,
+    method: 'POST',
+    path: '/api/v2/operations/{id}/cancel',
+    owner: 'Operations',
+    scope: 'operations:control',
+    project_scoped: true,
+    idempotency: 'required',
+    expected_revision: 'operation',
+    input_schema: 'operation.cancel.v2',
+    output_schema: 'operation.receipt.v2',
+    long_running: true,
+    events: ['operation.cancelled'],
+    mcp: { mapping: 'tool', name: 'operation_cancel' }
+  }
+];
+
+export const CLEAN_COMMAND_REGISTRY = Object.freeze(entries.map((entry) => Object.freeze({
+  ...entry,
+  pattern: entry.path,
+  required_scopes: Object.freeze([entry.scope]),
+  mcp: Object.freeze({ ...entry.mcp }),
+  events: Object.freeze([...entry.events])
+})));
+
+export function createCleanCommandRegistry() {
+  validateRegistry(CLEAN_COMMAND_REGISTRY);
+  return {
+    entries: CLEAN_COMMAND_REGISTRY,
+    get(commandId) { return CLEAN_COMMAND_REGISTRY.find((entry) => entry.command_id === commandId) || null; },
+    match(method, pathname) {
+      const normalized = String(pathname).replace(/\/$/, '') || '/';
+      return CLEAN_COMMAND_REGISTRY.find((entry) => entry.method === method && matchPattern(entry.path, normalized)) || null;
+    },
+    inventory() { return CLEAN_COMMAND_REGISTRY.map((entry) => ({ ...entry })); },
+    mcp() { return CLEAN_COMMAND_REGISTRY.map((entry) => ({ name: entry.mcp.name, mapping: entry.mcp.mapping, command_id: entry.command_id, version: entry.version, method: entry.method, path: entry.path, owner: entry.owner, scope: entry.scope, project_scoped: entry.project_scoped, idempotency: entry.idempotency, expected_revision: entry.expected_revision, long_running: entry.long_running, input_schema: entry.input_schema, output_schema: entry.output_schema, events: [...entry.events], required_scopes: [...entry.required_scopes] })); },
+    web() { return CLEAN_COMMAND_REGISTRY.map((entry) => ({ command_id: entry.command_id, version: entry.version, method: entry.method, path: entry.path, owner: entry.owner, scope: entry.scope, project_scoped: entry.project_scoped, idempotency: entry.idempotency, expected_revision: entry.expected_revision, long_running: entry.long_running, input_schema: entry.input_schema, output_schema: entry.output_schema, events: [...entry.events], mcp: { ...entry.mcp } })); }
+  };
+}
+
+export function validateRegistry(registry = CLEAN_COMMAND_REGISTRY) {
+  const ids = new Set();
+  const paths = new Set();
+  for (const entry of registry) {
+    for (const field of ['command_id', 'version', 'method', 'path', 'owner', 'scope', 'project_scoped', 'idempotency', 'expected_revision', 'input_schema', 'output_schema', 'long_running', 'events', 'mcp']) {
+      if (entry[field] == null) throw new Error(`registry_field_missing:${field}`);
+    }
+    if (ids.has(entry.command_id)) throw new Error(`registry_duplicate_command:${entry.command_id}`);
+    ids.add(entry.command_id);
+    const routeKey = `${entry.method} ${entry.path}`;
+    if (paths.has(routeKey)) throw new Error(`registry_duplicate_route:${routeKey}`);
+    paths.add(routeKey);
+    if (!/^\/api\/v2\//.test(entry.path)) throw new Error(`registry_non_v2_route:${entry.path}`);
+    if (entry.method !== 'GET' && entry.idempotency !== 'required') throw new Error(`registry_mutation_idempotency_missing:${entry.command_id}`);
+    if (entry.method !== 'GET' && entry.expected_revision === 'none') throw new Error(`registry_mutation_revision_missing:${entry.command_id}`);
+    if (entry.long_running && (!entry.events.length || !entry.output_schema.includes('operation'))) throw new Error(`registry_long_running_mapping_missing:${entry.command_id}`);
+    if (!entry.mcp?.name) throw new Error(`registry_mcp_mapping_missing:${entry.command_id}`);
+  }
+  return true;
+}
+
+function matchPattern(pattern, pathname) {
+  const expected = pattern.split('/').filter(Boolean);
+  const actual = pathname.split('/').filter(Boolean);
+  if (expected.length !== actual.length) return false;
+  return expected.every((part, index) => part.startsWith('{') && part.endsWith('}') || part === actual[index]);
+}
+
+export function routeParams(pattern, pathname) {
+  const expected = pattern.split('/').filter(Boolean);
+  const actual = pathname.split('/').filter(Boolean);
+  const params = {};
+  expected.forEach((part, index) => { if (part.startsWith('{') && part.endsWith('}')) params[part.slice(1, -1)] = decodeURIComponent(actual[index]); });
+  return params;
+}
+
+export function registryParity(registry = createCleanCommandRegistry()) {
+  const rest = registry.inventory();
+  const mcp = registry.mcp();
+  const web = registry.web();
+  const byId = (rows) => new Map(rows.map((row) => [row.command_id, row]));
+  const mcpById = byId(mcp);
+  const webById = byId(web);
+  const mismatches = [];
+  for (const entry of rest) {
+    const mcpEntry = mcpById.get(entry.command_id);
+    const webEntry = webById.get(entry.command_id);
+    if (!mcpEntry || mcpEntry.version !== entry.version || mcpEntry.method !== entry.method || mcpEntry.path !== entry.path || mcpEntry.owner !== entry.owner || mcpEntry.scope !== entry.scope || mcpEntry.project_scoped !== entry.project_scoped || mcpEntry.idempotency !== entry.idempotency || mcpEntry.expected_revision !== entry.expected_revision || mcpEntry.long_running !== entry.long_running || mcpEntry.input_schema !== entry.input_schema || mcpEntry.output_schema !== entry.output_schema || JSON.stringify(mcpEntry.events) !== JSON.stringify(entry.events)) mismatches.push(`${entry.command_id}:mcp`);
+    if (!webEntry || webEntry.version !== entry.version || webEntry.method !== entry.method || webEntry.path !== entry.path || webEntry.owner !== entry.owner || webEntry.scope !== entry.scope || webEntry.project_scoped !== entry.project_scoped || webEntry.idempotency !== entry.idempotency || webEntry.expected_revision !== entry.expected_revision || webEntry.long_running !== entry.long_running || webEntry.input_schema !== entry.input_schema || webEntry.output_schema !== entry.output_schema || JSON.stringify(webEntry.events) !== JSON.stringify(entry.events)) mismatches.push(`${entry.command_id}:web`);
+  }
+  return { valid: mismatches.length === 0, mismatches, rest_count: rest.length, mcp_count: mcp.length, web_count: web.length };
+}

diff --git a/apps/api/src/clean/runtime.mjs b/apps/api/src/clean/runtime.mjs
new file mode 100644
index 0000000..3d8f3be
--- /dev/null
+++ b/apps/api/src/clean/runtime.mjs
@@ -0,0 +1,73 @@
+import { loadCleanConfig } from './config.mjs';
+import { initializeCleanDatabase, CleanNotReadyError } from './database.mjs';
+import { RedactionPolicy } from './redaction.mjs';
+import { CasStore } from './cas.mjs';
+import { EventService } from './events.mjs';
+import { OperationService } from './operations.mjs';
+import { CleanPlatform } from './platform.mjs';
+import { createCleanCommandRegistry } from './registry.mjs';
+import { ReceiptService } from './receipts.mjs';
+import { canonicalJson } from './canonical.mjs';
+
+export function createCleanRuntime(options = {}) {
+  const config = options.config || loadCleanConfig(options.env || process.env);
+  let initialized;
+  try {
+    initialized = initializeCleanDatabase({ file: options.databaseFile || config.databaseFile, options: { receiptRoot: options.receiptRoot || config.receiptRoot, runtimeBuild: config.runtimeBuild, bootstrapActorId: options.bootstrapActorId } });
+  } catch (error) {
+    if (error instanceof CleanNotReadyError) throw error;
+    throw error;
+  }
+  const db = initialized.database;
+  const policy = options.policy || new RedactionPolicy();
+  const events = new EventService({ db, policy, cursorSecret: config.cursorSecret });
+  const platform = new CleanPlatform({ db, events, policy, bootstrapActorId: initialized.metadata.bootstrap_actor_id });
+  const operations = new OperationService({ db, events, policy, bootstrapActorId: initialized.metadata.bootstrap_actor_id });
+  const cas = new CasStore({ root: options.casRoot || config.casRoot, db, policy });
+  const receipts = new ReceiptService({ platform });
+  let casManifest;
+  let ready = false;
+  let readinessReason = null;
+  try {
+    casManifest = cas.verifyManifest(options.casManifest || null);
+    ready = true;
+  } catch (error) {
+    readinessReason = String(error?.code || error?.message || 'cas_manifest_invalid');
+    if (options.failOnCasMismatch === true) {
+      db.close();
+      throw error;
+    }
+  }
+  const existingRetired = db.get("SELECT id FROM receipt_manifests WHERE kind='route.retired' ORDER BY created_at,id LIMIT 1");
+  const retiredRouteReceipt = existingRetired?.id || platform.createReceipt({ kind: 'route.retired', payload: { code: 'route_retired', importer_command: 'import.inspect', schema_family: 'v3-clean' }, status: 'verified' }).receipt_id;
+  const registry = createCleanCommandRegistry();
+  const runtime = {
+    config,
+    db,
+    database: db,
+    metadata: initialized.metadata,
+    integrity: initialized.integrity,
+    policy,
+    events,
+    platform,
+    operations,
+    cas,
+    receipts,
+    casManifest,
+    registry,
+    retiredRouteReceipt,
+    ready,
+    readinessReason,
+    runtime: 'v3-clean',
+    apiVersion: '2',
+    health() {
+      return { runtime: 'v3-clean', ready: this.ready, readiness_reason: this.readinessReason, schema_family: this.metadata.family, user_version: this.metadata.user_version, cas_manifest: this.casManifest || null };
+    },
+    close() { this.db.close(); }
+  };
+  return runtime;
+}
+
+export function readinessEnvelope(runtime) {
+  return JSON.parse(canonicalJson(runtime.health()));
+}

