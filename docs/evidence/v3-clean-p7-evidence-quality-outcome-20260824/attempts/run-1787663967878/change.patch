+  }
+}
+
+export class BrokerParserAdapter {
+  constructor({ baseUrl = null, secret = '', fetchImpl = globalThis.fetch, clock = () => Date.now() } = {}) {
+    this.baseUrl = baseUrl ? String(baseUrl).replace(/\/$/, '') : null;
+    this.secret = String(secret || '');
+    this.fetch = fetchImpl;
+    this.clock = clock;
+  }
