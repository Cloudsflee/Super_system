+    }
+    return String(version.content || '');
+  }
+}
+
+function typeOrder(kind) {
+  return ({ project: 10, brief: 20, repository: 30, workflow: 40, node_contract: 50, note: 60, file: 70, diff: 80, test_report: 90 }[kind] || 100);
+}
