{
  "schema_version": "aiws.v3-clean.p1-gate-sync-contract.v1",
  "phase": "P1",
  "rules": [
    {
      "id": "GS-001",
      "requirement": "A change to tests, gate commands, routes, schemas, ownership, phase scope, status rules, or receipt shapes MUST trigger gate-sync review."
    },
    {
      "id": "GS-002",
      "requirement": "The phase plan, testing policy, package/CI commands, gate implementation, tests, Catalog/matrix, and Evidence references MUST update atomically."
    },
    {
      "id": "GS-003",
      "requirement": "Every governed inventory MUST be bidirectional and MUST reject missing, stale, duplicate, and orphan entries."
    },
    {
      "id": "GS-004",
      "requirement": "Every Git-visible non-build path MUST be classified; every new governance file MUST declare an owner and phase and be registered in the Catalog."
    },
    {
      "id": "GS-005",
      "requirement": "Only final verified, non-provisional receipts MAY promote status; failed and checkpoint receipts remain immutable."
    },
    {
      "id": "GS-006",
      "requirement": "Rollback verification MUST include a runnable dry-run and an isolated actual apply with byte-exact comparison."
    },
    {
      "id": "GS-007",
      "requirement": "Any gate failure MUST freeze the affected Catalog status and block dependent phases."
    }
  ],
  "commands": [
    "pnpm check",
    "pnpm audit:p1",
    "pnpm scan:clean",
    "pnpm test:p1",
    "pnpm recovery:plan",
    "pnpm recovery:catalog",
    "pnpm recovery:coverage",
    "pnpm recovery:impact -- --audit",
    "pnpm verify"
  ],
  "governing_documents": [
    "AGENTS.md",
    "docs/testing.md",
    "docs/architecture/v3-clean-development-plan.md"
  ],
  "catalog_paths": {
