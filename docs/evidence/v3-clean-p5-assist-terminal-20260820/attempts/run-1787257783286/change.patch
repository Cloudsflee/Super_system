--- /dev/null
+++ b/scripts/v3-clean-p5-assist-probe.mjs
@@ -0,0 +1,46 @@
+import { ProcessAppServerAdapter, APP_SERVER_METHODS, APP_SERVER_SCHEMA_SHA256 } from '../apps/api/src/clean/app-server-adapter.mjs';
+import { createCleanRuntime } from '../apps/api/src/clean/runtime.mjs';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+const root = fs.mkdtempSync(path.join(os.tmpdir(), 'aiws-p5-assist-probe-'));
+const provider = new ProcessAppServerAdapter({
+  command: process.env.AIWS_CLEAN_PROVIDER_COMMAND || 'codex',
+  timeoutMs: Number(process.env.AIWS_CLEAN_PROVIDER_TIMEOUT_MS || 20_000),
+  homeRoot: path.join(root, 'provider-homes')
+});
+const config = {
+  runtime: 'v3-clean', apiVersion: '2', host: '127.0.0.1', port: 0, home: root,
+  databaseFile: path.join(root, 'data', 'state.sqlite'), casRoot: path.join(root, 'cas'),
+  receiptRoot: path.join(root, 'receipts'), vaultRoot: path.join(root, 'vault'),
+  cursorSecret: 'p5-assist-probe-cursor-secret', sessionSecret: 'p5-assist-probe-session-secret',
+  vaultMasterKey: 'p5-assist-probe-vault-master-secret', mcpPepper: 'p5-assist-probe-mcp-pepper',
+  gatewaySecret: 'p5-assist-probe-gateway-secret', gatewayId: 'p5-assist-probe-gateway',
+  runtimeBuild: 'v3-clean-p5-assist-probe', maxBodyBytes: 2_000_000
+};
+let runtime;
+try {
+  runtime = createCleanRuntime({ config, targetVersion: 5, providerAdapter: provider });
+  await runtime.recovery;
+  const probe = await runtime.assist.probeProvider();
+  if (probe.protocol_version !== '2' || probe.schema_sha256 !== APP_SERVER_SCHEMA_SHA256) throw new Error('assist_probe_schema_mismatch');
+  const requiredMethods = APP_SERVER_METHODS.filter((method) => method !== 'initialize');
+  const availableMethods = new Set((probe.methods || []).map(String));
+  for (const method of requiredMethods) if (!availableMethods.has(method)) throw new Error(`assist_probe_method_missing:${method}`);
+  const thread = await provider.startThread({});
+  const credentialConfigured = Boolean(process.env.AIWS_P5_PROVIDER_CREDENTIAL || process.env.OPENAI_API_KEY);
+  process.stdout.write(`${JSON.stringify({
+    schema_version: 'aiws.v3-clean.p5-assist-probe.v1', status: 'passed', provisional: false,
+    protocol_version: probe.protocol_version, schema_sha256: probe.schema_sha256,
+    generated_schema_sha256: probe.generated_schema_sha256,
+    methods: APP_SERVER_METHODS, thread_started: Boolean(thread.thread_id), thread_resume_probe: 'deferred_until_persisted_turn',
+    model_turn: credentialConfigured ? 'not_run_external_latency' : 'skipped_provider_credential_not_configured',
+    adapter: probe.adapter, isolated_codex_home: true, credential_lease: 'memory_only',
+    redactions: ['credential', 'assembled_prompt', 'host_absolute_path']
+  }, null, 2)}\n`);
+} finally {
+  await runtime?.close?.();
+  await provider.close();
+  fs.rmSync(root, { recursive: true, force: true });
+}
