+    aggregateType: 'p5_performance', aggregateId, revision: i, actorId: state.principal.actorId, projectId: project.id,
+    type: i === 1000 ? 'p5_performance.completed' : 'p5_performance.progress', data: { index: i }, payload: { index: i }, now
+  }));
