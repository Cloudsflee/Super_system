+    let actor = this.db.get("SELECT a.* FROM actors a JOIN team_memberships m ON m.actor_id=a.id WHERE a.status='active' AND m.status='active' AND m.role='owner' ORDER BY a.kind='user' DESC,a.id LIMIT 1");
