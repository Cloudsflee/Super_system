diff --git a/docs/evidence/v3-clean-p9-web-release-20260826/attempts/run-1787913946235/rollback-verify.mjs b/docs/evidence/v3-clean-p9-web-release-20260826/attempts/run-1787913946235/rollback-verify.mjs
