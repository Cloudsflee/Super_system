+    if (!oldHeader && line.startsWith('--- ')) { oldHeader = true; return oldExists ? `--- a/${file}` : '--- /dev/null'; }
+    if (!newHeader && line.startsWith('+++ ')) { newHeader = true; return newExists ? `+++ b/${file}` : '+++ /dev/null'; }
+    return line;
+  }).join('\n');
+}
+
+function writeManifest(status) {
