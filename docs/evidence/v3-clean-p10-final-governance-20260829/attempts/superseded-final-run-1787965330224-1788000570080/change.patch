+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), this.timeoutMs);
+    timer.unref?.();
+    try {
+      const response = await this.fetch(url, {
+        method: 'POST',
+        signal: controller.signal,
+        headers: {
+          accept: 'application/json, text/event-stream',
