+  family: 'v3-clean',
+  sql: FINAL_BUSINESS_PARITY_GOVERNANCE_SQL,
+  checksum: FINAL_BUSINESS_PARITY_GOVERNANCE_MIGRATION_CHECKSUM,
+  toolVersion: FINAL_BUSINESS_PARITY_GOVERNANCE_TOOL_VERSION
+});
