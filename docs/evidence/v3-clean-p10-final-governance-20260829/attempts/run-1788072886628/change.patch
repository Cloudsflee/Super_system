+
+const tabs = [
+  { id: 'provider', label: 'Provider', icon: Settings2 },
+  { id: 'brief', label: 'Brief templates', icon: Archive },
+  { id: 'project-delete', label: 'Project deletion', icon: Trash2 },
+  { id: 'repository-delete', label: 'Repository deletion', icon: GitBranch },
