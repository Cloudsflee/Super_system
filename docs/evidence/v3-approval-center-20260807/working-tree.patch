+    const ttl = Number(input?.ttl_seconds ?? 3600);
+    assert(Number.isInteger(ttl) && ttl >= 60 && ttl <= 7 * 24 * 60 * 60, 'invalid_input', 'approval ttl is invalid', { status: 422 });
+    const approvalId = id('rap');
