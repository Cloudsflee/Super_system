 .asset-table .table-head, .asset-table .table-row { grid-template-columns: minmax(220px, 1.6fr) .5fr .9fr .6fr 36px; }.asset-table .table-row > span:first-child strong, .asset-table .table-row > span:first-child small { display: block; }.asset-table small { color: var(--muted); margin-top: 3px; }
