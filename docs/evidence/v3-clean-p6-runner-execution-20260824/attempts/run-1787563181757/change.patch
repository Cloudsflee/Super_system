+  const receipt = { schema_version: 'runner.receipt.v2', receipt_id: 'receipt_fixture', job_spec_id: spec.job_spec_id, job_spec_hash: signed.spec_sha256, runner_profile_ref: spec.runner_profile_ref, runner_job_ref: 'runner_job_fixture', status: 'succeeded', exit_code: 0, stdout_sha256: '', stderr_sha256: '', output_sha256: '', stdout_bytes: 0, stderr_bytes: 0, output_bytes: 0, output_paths: [], error_code: '', started_at: new Date(now).toISOString(), finished_at: new Date(now + 1).toISOString() };
