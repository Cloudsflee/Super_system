+    {kind === 'local' ? <label><span>仓库目录</span><input aria-label="仓库目录" value={locator} onChange={event => onLocatorChange(event.target.value)} placeholder="本机可访问的绝对路径" /></label> : <>
+      <div className="form-actions"><button type="button" className="button" onClick={onDiscover}><Github size={15} />发现可用仓库</button>{!profiles.some(profile => profile.provider === 'github' && profile.status === 'available' && profile.lifecycle_status !== 'disabled') && <small className="fault-text">请先验证 GitHub Profile</small>}</div>
