--- /dev/null
+++ b/scripts/production-lifecycle.mjs
@@ -0,0 +1,29 @@
+import fs from 'node:fs';
+import fsp from 'node:fs/promises';
+import path from 'node:path';
+import os from 'node:os';
+import { randomUUID, createHash } from 'node:crypto';
+import { spawn } from 'node:child_process';
+
+const root = path.resolve(new URL('..', import.meta.url).pathname.replace(/^\/(?:[A-Za-z]:)/, (m) => m.slice(1)));
+const home = path.resolve(process.env.AIWS_CLEAN_HOME || path.join(root, '.ai-workspace', 'v3-clean'));
+const stateFile = path.join(home, 'service.json');
+const componentNames = ['data', 'cas', 'vault', 'workspaces', 'runner-homes', 'provider-homes', 'receipts', 'config'];
+
+function ensureLayout() { for (const name of [...componentNames, 'backups', 'rollback']) fs.mkdirSync(path.join(home, name), { recursive: true, mode: 0o700 }); }
+function readState() { try { return JSON.parse(fs.readFileSync(stateFile, 'utf8')); } catch { return null; } }
+function writeState(value) { fs.mkdirSync(home, { recursive: true, mode: 0o700 }); fs.writeFileSync(stateFile, `${JSON.stringify(value, null, 2)}\n`, { mode: 0o600 }); }
+function digest(file) { const hash = createHash('sha256'); if (!fs.existsSync(file)) return null; const stat = fs.statSync(file); if (stat.isDirectory()) { for (const item of listFiles(file)) hash.update(item.relative).update(fs.readFileSync(item.path)); } else hash.update(fs.readFileSync(file)); return hash.digest('hex'); }
+function listFiles(dir, base = dir) { const rows = []; for (const entry of fs.readdirSync(dir, { withFileTypes: true })) { const file = path.join(dir, entry.name); if (entry.isDirectory()) rows.push(...listFiles(file, base)); else rows.push({ path: file, relative: path.relative(base, file).replaceAll('\\', '/') }); } return rows.sort((a, b) => a.relative.localeCompare(b.relative)); }
+function manifest() { return Object.fromEntries(componentNames.map((name) => [name, digest(path.join(home, name))])); }
+function pidAlive(pid) { if (!Number.isInteger(Number(pid)) || Number(pid) <= 0) return false; try { process.kill(Number(pid), 0); return true; } catch { return false; } }
