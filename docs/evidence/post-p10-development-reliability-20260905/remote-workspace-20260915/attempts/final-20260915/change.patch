+  return <div className="preparation-source-selector" data-testid="preparation-source-selector">
+    <div className="segmented" role="group" aria-label="仓库来源">
+      <button type="button" className={kind === 'local' ? 'active' : ''} onClick={() => onKindChange('local')}><FolderGit2 size={15} />本机 Git</button>
+      <button type="button" className={kind === 'github' ? 'active' : ''} onClick={() => onKindChange('github')}><Github size={15} />GitHub</button>
