+        now
+      });
+      const response = {
+        project: this.#projectView(tx.get('SELECT * FROM projects WHERE id=?', [row.id]), true, tx),
+        operation: operationView(op)
+      };
+      saveIdempotency(
+        tx,
+        principal.actorId,
+        command,
+        key,
+        hash,
+        response,
+        op.id,
+        now
+      );
