+
+function fixture() {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'v3-clean-p3-http-'));
+  return {
+    root,
+    config: {
+      runtime: 'v3-clean',
+      apiVersion: '2',
+      host: '127.0.0.1',
+      port: 0,
+      home: root,
