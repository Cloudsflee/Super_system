+      AIWS_CLEAN_HOME: f.root,
+      AIWS_CLEAN_PORT: '4317',
+      AIWS_CLEAN_CURSOR_SECRET: 'active-entrypoint-cursor-secret',
+      AIWS_CLEAN_SESSION_SECRET: 'active-entrypoint-session-secret',
