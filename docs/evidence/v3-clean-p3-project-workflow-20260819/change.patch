+        aggregateType: 'project',
+        aggregateId: project.id,
+        revision: expected + 1,
+        operationId: operation.id,
+        actorId: principal.actorId,
+        projectId: project.id,
+        type: 'project.brief_updated',
+        data: { project_id: project.id, brief_revision: revision },
