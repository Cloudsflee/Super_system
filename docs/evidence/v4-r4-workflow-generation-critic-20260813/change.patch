+      draft_revision: draft.json.revision,
+      nodes: [{ id: 'inspect', position: { x: 40, y: 80 } }],
+      viewport: { x: 0, y: 0, zoom: 1 }
+    }, 'r4-success-layout');
+    assert.equal(layout.response.status, 201);
