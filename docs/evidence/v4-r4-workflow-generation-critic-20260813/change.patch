+        <div className="generation-events">{events.slice(-6).map((event) => <div key={event.cursor}><span /><p>{event.type.replace('workflow.generation.', '')}</p><small>#{event.cursor}</small></div>)}</div>
+      </aside>
+    </div>
+  </div>;
+}
