{
  "version": "2.2",
  "match_mode": "all",
  "mappings": [
    {
      "domain": "state",
      "patterns": ["apps/api/src/state*.mjs", "apps/api/src/config.mjs", "tests/unit/v22-state-store.test.mjs"],
      "tests": ["V22-L1-STATE-001", "V22-L2-MIGRATION-001", "V22-L7-RELEASE-001"]
    },
    {
      "domain": "context",
      "patterns": ["apps/api/src/context-*.mjs", "packages/system-context/**", "tests/unit/v22-projector-index.test.mjs"],
      "tests": ["V22-L3-PROJECTOR-001", "V22-L5-FAULT-002", "V22-L6-PERFORMANCE-001"]
    },
    {
      "domain": "runtime",
      "patterns": ["apps/api/server.mjs", "apps/api/src/runtime-health.mjs", "apps/api/src/shutdown-coordinator.mjs", "apps/api/src/workflow-dispatcher.mjs", "apps/api/src/terminal-service.mjs", "apps/api/src/host-bridge-service.mjs"],
      "tests": ["V22-L4-HEALTH-001"]
    },
    {
      "domain": "gate",
      "patterns": ["scripts/impact-range.mjs", "scripts/v18-contract.mjs", "scripts/v175-impact.mjs", "scripts/v22-*.mjs", "scripts/compat-pr-runner.mjs", "scripts/gate-scheduler.mjs", "scripts/pre-push-gate.mjs", "scripts/gate-receipt-v22.mjs", ".githooks/**", ".github/**"],
      "tests": ["V22-L0-IMPACT-004", "V22-L5-SECURITY-001"]
    },
    {
      "domain": "release",
      "patterns": ["Dockerfile", "compose*.yml", "docker/**", "tests/release/v22-*.mjs"],
      "tests": ["V22-L2-MIGRATION-001", "V22-L7-RELEASE-001"]
    },
    {
      "domain": "governance",
      "patterns": ["package.json", "apps/*/package.json", "packages/*/package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", ".dockerignore", ".gitattributes", ".gitignore", ".prettierignore", ".prettierrc.json", "eslint.config.mjs", "tests/v22/**", "scripts/**", "README.md", "docs/**", "*.md", "*.json", "*.yml", "*.yaml"],
      "tests": ["V22-L0-PLAN-001", "V22-L0-CATALOG-002", "V22-L0-COVERAGE-003", "V22-L0-IMPACT-004"]
    },
    {
      "domain": "system-fallback",
      "patterns": ["apps/**", "packages/**", "bridge/**", "config/**", "prisma/**", "tests/**", "scripts/**", "docker/**", "doc/**", "任务书/**", "当前项目毕业设计任务书/**", "愿景与范围文档模板/**", "探索*/**", "*.go"],
      "tests": ["V22-L0-IMPACT-004", "V22-L5-SECURITY-001"]
    }
  ]
}
