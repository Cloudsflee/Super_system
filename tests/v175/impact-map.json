{
  "version": "1.75",
  "match_mode": "first",
  "business_roots": ["apps/api", "apps/web/src", "packages", "prisma", "docker"],
  "business_files": ["Dockerfile", "compose.yml", "scripts/aiws.ps1", "scripts/aiws.sh", "scripts/v16-release.mjs", "scripts/v17-release.mjs"],
  "exclude": ["apps/web/src/test/**", "**/dist/**", "**/node_modules/**"],
  "mappings": [
    { "patterns": ["apps/api/src/routes/assist*.mjs", "apps/api/src/assist-*.mjs", "apps/api/src/assist*.mjs"], "domains": ["assist", "action"], "priority": "P0" },
    { "patterns": ["apps/api/src/routes/workflow*.mjs", "apps/api/src/routes/approvals*.mjs", "apps/api/src/routes/change-proposals.mjs", "apps/api/src/workflow-*.mjs", "apps/api/src/proposal-*.mjs"], "domains": ["workflow", "change"], "priority": "P0" },
    { "patterns": ["apps/api/src/routes/codex*.mjs", "apps/api/src/routes/setup*.mjs", "apps/api/src/codex-*.mjs", "apps/api/src/container-*.mjs", "apps/api/src/setup-*.mjs"], "domains": ["setup", "runtime"], "priority": "P0" },
    { "patterns": ["apps/api/src/routes/files*.mjs", "apps/api/src/routes/assets.mjs", "apps/api/src/file-*.mjs", "apps/api/src/attachment-*.mjs", "apps/api/src/managed-workspace.mjs"], "domains": ["files"], "priority": "P0" },
    { "patterns": ["apps/api/src/routes/git*.mjs", "apps/api/src/routes/github*.mjs", "apps/api/src/git-*.mjs", "apps/api/src/github-*.mjs"], "domains": ["git"], "priority": "P0" },
    { "patterns": ["apps/api/src/routes/terminal*.mjs", "apps/api/src/routes/host-bridge*.mjs", "apps/api/src/terminal-*.mjs", "apps/api/src/host-bridge-*.mjs", "apps/api/src/worktree-*.mjs", "apps/api/src/change-*.mjs"], "domains": ["change"], "priority": "P0" },
    { "patterns": ["apps/api/src/state*.mjs", "apps/api/src/config.mjs", "apps/api/src/*migration*.mjs"], "domains": ["state", "release"], "priority": "P0" },
    { "patterns": ["apps/api/**"], "domains": ["api-core"], "priority": "P0" },
    { "patterns": ["apps/web/src/features/assist/**", "apps/web/src/components/assist/**", "apps/web/src/operations/**"], "domains": ["web", "assist", "action"], "priority": "P0" },
    { "patterns": ["apps/web/src/features/projects/onboarding/**"], "domains": ["web", "onboard"], "priority": "P0" },
    { "patterns": ["apps/web/src/features/workflow/**", "apps/web/src/components/approvals/**", "apps/web/src/components/proposals/**"], "domains": ["web", "workflow"], "priority": "P0" },
    { "patterns": ["apps/web/src/**", "apps/web/package.json", "apps/web/index.html"], "domains": ["web"], "priority": "P1" },
    { "patterns": ["packages/shared/src/assist*.mjs", "packages/shared/src/collaboration.mjs"], "domains": ["assist", "action", "workflow"], "priority": "P0" },
    { "patterns": ["packages/**"], "domains": ["api-core"], "priority": "P1" },
    { "patterns": ["prisma/**"], "domains": ["state", "release"], "priority": "P0" },
    { "patterns": ["Dockerfile", "compose.yml", "docker/**", "scripts/aiws.ps1", "scripts/aiws.sh", "scripts/v16-release.mjs", "scripts/v17-release.mjs"], "domains": ["runtime", "release"], "priority": "P0" },
    { "patterns": ["apps/web/src/test/**"], "domains": ["web"], "priority": "P1" },
    { "patterns": ["scripts/v175-*.mjs", "tests/v175/**", "测试计划v1.75.md", ".github/**", ".githooks/**", ".gitattributes"], "domains": ["governance"], "priority": "P0" },
    { "patterns": ["tests/unit/*codex*.mjs", "tests/integration/*codex*.mjs"], "domains": ["runtime", "setup"], "priority": "P0" },
    { "patterns": ["tests/unit/*workflow*.mjs", "tests/integration/*workflow*.mjs"], "domains": ["workflow", "action"], "priority": "P0" },
    { "patterns": ["tests/integration/*assist*.mjs", "tests/unit/*capability*.mjs"], "domains": ["assist", "action"], "priority": "P0" },
    { "patterns": ["tests/e2e/v175-user-journey*.mjs"], "domains": ["e2e", "web", "setup", "onboard", "assist", "action", "workflow", "change", "files", "git", "runtime", "state"], "priority": "P0" },
    { "patterns": ["tests/e2e/**"], "domains": ["e2e", "web"], "priority": "P1" },
    { "patterns": ["tests/release/**"], "domains": ["release"], "priority": "P0" },
    { "patterns": ["tests/**"], "domains": ["api-core", "state", "runtime", "assist", "action", "workflow", "change", "files", "git", "web"], "priority": "P1" },
    { "patterns": ["scripts/**", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml"], "domains": ["governance", "static"], "priority": "P1" },
    { "patterns": ["README.md", "docs/**", "*.md"], "domains": ["governance"], "priority": "P2" }
  ]
}
