{
  "version": "2.1",
  "match_mode": "all",
  "mappings": [
    {
      "domain": "execution-protocol",
      "patterns": ["packages/execution-protocol/**", "apps/api/src/deployment-evidence-*.mjs", "tests/unit/v21-execution-protocol.test.mjs"],
      "tests": ["V21-L1-PROTOCOL-001", "V21-L5-SECURITY-001"]
    },
    {
      "domain": "outcome",
      "patterns": ["apps/api/src/outcome-*.mjs", "apps/api/src/workflow-outcome-*.mjs", "apps/api/src/workflow-finalization-*.mjs", "tests/unit/v21-outcome.test.mjs"],
      "tests": ["V21-L1-OUTCOME-002", "V21-L3-INTEGRATION-001", "V21-L7-FIXTURE-001"]
    },
    {
      "domain": "execution",
      "patterns": ["apps/api/src/execution-*.mjs", "apps/api/src/runner-preflight.mjs", "apps/api/src/routes/runs.mjs", "apps/api/src/task-execution-*.mjs", "apps/api/src/workflow-dispatcher.mjs", "apps/api/src/workflow-execution-*.mjs", "tests/unit/v21-stage-replay.test.mjs", "tests/integration/v21-stage-replay-flow.test.mjs"],
      "tests": ["V21-L1-REPLAY-003", "V21-L3-INTEGRATION-001", "V21-L5-SECURITY-001"]
    },
    {
      "domain": "context",
      "patterns": ["packages/system-context/**", "packages/shared/src/context-run.mjs", "apps/api/src/context-*.mjs", "apps/api/src/task-execution-context.mjs", "tests/unit/v21-context.test.mjs"],
      "tests": ["V21-L1-CONTEXT-004", "V21-L5-FAULT-002", "V21-L6-PERFORMANCE-001", "V21-L6-SOAK-002"]
    },
    {
      "domain": "state",
      "patterns": ["apps/api/src/state.mjs", "apps/api/src/state-migration-v20.mjs", "apps/api/src/state-migration-v21.mjs", "apps/api/src/config.mjs", "tests/unit/v21-migration.test.mjs"],
      "tests": ["V21-L2-MIGRATION-001", "V21-L7-RELEASE-002"]
    },
    {
      "domain": "api-governance",
      "patterns": ["apps/api/server.mjs", "apps/api/src/api-route-registry.mjs", "apps/api/src/project-governance-v19.mjs", "apps/api/src/project-lifecycle.mjs", "apps/api/src/routes/workflow-executions-v110.mjs"],
      "tests": ["V21-L3-INTEGRATION-001", "V21-L5-SECURITY-001"]
    },
    {
      "domain": "web",
      "patterns": ["apps/web/**", "tests/e2e/v21-*.mjs"],
      "tests": ["V21-L4-WEB-001", "V21-L4-BROWSER-002"]
    },
    {
      "domain": "security",
      "patterns": ["apps/api/src/runner-preflight.mjs", "apps/api/src/execution-replay-service.mjs", "packages/execution-protocol/**", "scripts/gate-receipt-v21.mjs", "scripts/pre-push-gate.mjs", "tests/unit/v21-security.test.mjs"],
      "tests": ["V21-L1-PROTOCOL-001", "V21-L1-REPLAY-003", "V21-L5-SECURITY-001"]
    },
    {
      "domain": "performance",
      "patterns": ["apps/api/src/context-projection-worker.mjs", "apps/api/src/context-projector-coordinator.mjs", "apps/api/src/workflow-finalization-service.mjs", "tests/unit/v21-performance.test.mjs", "tests/v21/soak.test.mjs"],
      "tests": ["V21-L5-FAULT-002", "V21-L6-PERFORMANCE-001", "V21-L6-SOAK-002"]
    },
    {
      "domain": "release",
      "patterns": ["Dockerfile", "compose*.yml", "docker/**", "scripts/aiws.*", "scripts/v21-release.mjs", "tests/release/v21-*.mjs"],
      "tests": ["V21-L2-MIGRATION-001", "V21-L7-RELEASE-002"]
    },
    {
      "domain": "governance",
      "patterns": ["package.json", "apps/*/package.json", "packages/*/package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", ".github/**", ".githooks/**", ".gitignore", ".prettierignore", ".prettierrc.json", ".gitattributes", ".dockerignore", "eslint.config.mjs", "scripts/**", "tests/v21/**", "README.md", "docs/**", "*.md"],
      "tests": ["V21-L0-PLAN-001", "V21-L0-CATALOG-002", "V21-L0-COVERAGE-003", "V21-L0-IMPACT-004"]
    },
    {
      "domain": "system-fallback",
      "patterns": ["apps/**", "packages/**", "bridge/**", "config/**", "prisma/**", "tests/**", "scripts/**", "docker/**", "doc/**", "任务书/**", "当前项目毕业设计任务书/**", "愿景与范围文档模板/**", "探索*/**", "*.json", "*.yml", "*.yaml", "*.go"],
      "tests": ["V21-L0-IMPACT-004", "V21-L5-SECURITY-001"]
    }
  ]
}
