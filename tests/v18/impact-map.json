{
  "version": "1.8",
  "match_mode": "all",
  "mappings": [
    { "patterns": ["开发计划v1.8.md", "测试计划v1.8.md", "tests/v18/**", "scripts/v18-*.mjs"], "suites": ["plan", "contract"] },
    { "patterns": ["apps/api/server.mjs", "apps/api/src/http.mjs", "apps/api/src/routes/**", "apps/api/src/mcp/**"], "suites": ["contract", "parity", "security", "journey"] },
    { "patterns": ["apps/mcp-gateway/**", "compose.collaboration.yml", "packages/mcp-bridge/**"], "suites": ["contract", "security", "release"] },
    { "patterns": ["apps/api/src/state*.mjs", "apps/api/src/config.mjs", "prisma/schema.prisma"], "suites": ["contract", "security", "release"] },
    { "patterns": ["apps/api/src/terminal*.mjs", "apps/api/src/host-bridge*.mjs"], "suites": ["contract", "fault", "journey"] },
    { "patterns": ["apps/api/src/codex*.mjs", "apps/api/src/assist*.mjs"], "suites": ["contract", "journey", "live"] },
    { "patterns": ["apps/web/**"], "suites": ["contract", "browser"] },
    { "patterns": ["compose.yml", "Dockerfile", "docker/**", "scripts/aiws.*", "scripts/v18-release.mjs"], "suites": ["release"] },
    { "patterns": ["package.json", "pnpm-lock.yaml", "packages/**"], "suites": ["contract", "full"] },
    { "patterns": ["apps/api/**", "apps/worker/**"], "suites": ["contract", "security", "full"] },
    { "patterns": ["tests/**", "scripts/**", ".github/**", ".githooks/**", ".gitattributes"], "suites": ["plan", "full"] },
    { "patterns": ["README.md", "docs/**", "doc/**", "bridge/**", "config/**", "*.md", "*.yml", "*.yaml"], "suites": ["contract"] }
  ]
}
