{
  "version": "2.3",
  "match_mode": "all",
  "mappings": [
    {
      "domain": "quality-review",
      "patterns": [
        "apps/api/src/quality-review-*.mjs",
        "apps/api/src/routes/quality-reviews-v23.mjs",
        "apps/web/src/features/workflow/QualityReview*.tsx",
        "apps/web/src/features/workflow/quality-review*.ts",
        "apps/web/src/styles/quality-review.css",
        "apps/web/src/test/quality-review-v23.test.tsx",
        "packages/execution-protocol/**",
        "tests/unit/v23-quality-review*.test.mjs",
        "tests/integration/v23-quality-review-flow.test.mjs",
        "tests/security/v23-quality-review-security.test.mjs",
        "tests/performance/v23-quality-review-performance.test.mjs",
        "tests/e2e/v23-quality-review-browser*.mjs",
        "tests/release/v23-release-contract.test.mjs"
      ],
      "tests": [
        "V23-L1-QUALITY-001",
        "V23-L1-STATE-002",
        "V23-L3-PARSER-001",
        "V23-L3-WEB-002",
        "V23-L3-BROWSER-003",
        "V23-L4-LIFECYCLE-001",
        "V23-L5-SECURITY-001",
        "V23-L6-PERFORMANCE-001",
        "V23-L7-RELEASE-001"
      ]
    },
    {
      "domain": "state",
      "patterns": [
        "apps/api/src/state*.mjs",
        "apps/api/src/config.mjs",
        "apps/api/src/state-store*.mjs",
        "tests/unit/v23-quality-review-state.test.mjs",
        "tests/release/v23-volume-flow.test.mjs"
      ],
      "tests": ["V23-L1-STATE-002", "V23-L2-MIGRATION-001", "V23-L7-RELEASE-001"]
    },
    {
      "domain": "runtime",
      "patterns": [
        "apps/api/server.mjs",
        "apps/api/src/runtime-health.mjs",
        "apps/api/src/shutdown-coordinator.mjs",
        "apps/api/src/workflow-dispatcher.mjs"
      ],
      "tests": ["V23-L4-LIFECYCLE-001"]
    },
    {
      "domain": "gate",
      "patterns": [
        "scripts/v23-*.mjs",
        "scripts/gate-receipt-v23.mjs",
        "scripts/impact-range.mjs",
        "scripts/compat-pr-runner.mjs",
        ".githooks/**",
        ".github/**"
      ],
      "tests": ["V23-L0-PLAN-001", "V23-L0-CATALOG-002", "V23-L0-COVERAGE-003", "V23-L0-IMPACT-004"]
    },
    {
      "domain": "release",
      "patterns": [
        "Dockerfile",
        "compose*.yml",
        "bridge/**",
        "docker/**",
        "scripts/acceptance-*.mjs",
        "tests/release/v23-*.mjs"
      ],
      "tests": ["V23-L2-MIGRATION-001", "V23-L7-RELEASE-001"]
    },
    {
      "domain": "governance",
      "patterns": [
        "package.json",
        "apps/*/package.json",
        "packages/*/package.json",
        "pnpm-lock.yaml",
        ".dockerignore",
        ".gitattributes",
        ".gitignore",
        ".prettierignore",
        ".prettierrc.json",
        "eslint.config.mjs",
        "tests/v23/**",
        "README.md",
        "docs/**",
        "*.md",
        "*.json",
        "*.yml",
        "*.yaml"
      ],
      "tests": ["V23-L0-PLAN-001", "V23-L0-CATALOG-002", "V23-L0-COVERAGE-003", "V23-L0-IMPACT-004"]
    },
    {
      "domain": "system-fallback",
      "patterns": [
        "apps/**",
        "packages/**",
        "bridge/**",
        "config/**",
        "prisma/**",
        "tests/**",
        "scripts/**",
        "docker/**",
        "doc/**",
        "任务书/**",
        "当前项目毕业设计任务书/**",
        "愿景与范围文档模板/**",
        "探索*/**",
        "*.go"
      ],
      "tests": ["V23-L0-IMPACT-004", "V23-L5-SECURITY-001"]
    }
  ]
}
