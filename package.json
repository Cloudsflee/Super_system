{
  "name": "ai-workspace-system",
  "version": "3.0.0",
  "private": true,
  "description": "Local single-user AI collaboration development workspace",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "24.14.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node apps/api/server.mjs",
    "dev:broker": "node apps/runner-broker/server.mjs",
    "start": "node apps/api/server.mjs",
    "build": "corepack pnpm --filter @aiws/web build",
    "check": "node scripts/check.mjs",
    "typecheck": "corepack pnpm --filter @aiws/web typecheck",
    "test": "node --test tests/unit/*.test.mjs && corepack pnpm --filter @aiws/web test",
    "test:integration": "node --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=75 --test tests/integration/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:security": "node --test --test-concurrency=1 tests/security/*.test.mjs",
    "test:release": "node --test tests/release/*.test.mjs",
    "test:runner-real": "node scripts/runner-real-smoke.mjs",
    "github:seed-fixture": "node scripts/github-seed-fixture.mjs",
    "verify": "node scripts/verify.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "archive:v23": "node scripts/archive-v23.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "release:build": "node scripts/release-build.mjs",
    "release:rehearse": "node scripts/release-rehearsal.mjs",
    "release:promote": "node scripts/release-promote.mjs",
    "recovery:plan": "node scripts/recovery-governance.mjs plan",
    "recovery:catalog": "node scripts/recovery-governance.mjs catalog",
    "recovery:coverage": "node scripts/recovery-governance.mjs coverage",
    "recovery:impact": "node scripts/recovery-governance.mjs impact"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.53.2"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "smol-toml": "1.7.0",
    "ws": "^8.21.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ]
  }
}
