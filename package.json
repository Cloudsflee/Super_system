{
  "name": "ai-workspace-system",
  "version": "3.0.0",
  "private": true,
  "description": "Local single-user AI collaboration development workspace",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "24.14.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:clean": "node apps/api/server.mjs",
    "dev:api": "node apps/api/server.mjs",
    "dev:broker": "node apps/runner-broker/clean-server.mjs",
    "fixture:legacy:dev-broker": "node apps/runner-broker/server.mjs",
    "start": "node apps/api/server.mjs",
    "start:clean": "node apps/api/server.mjs",
    "build": "corepack pnpm --filter @aiws/web build",
    "check": "node scripts/check.mjs",
    "scan:clean": "node scripts/v3-clean-architecture-scan.mjs",
    "audit:p1": "node scripts/v3-clean-workspace-audit.mjs",
    "typecheck": "corepack pnpm --filter @aiws/web typecheck",
    "test": "node scripts/test.mjs",
    "test:p1": "node --test tests/p1/*.test.mjs tests/integration/v3-clean-p1.test.mjs tests/security/v3-clean-p1.test.mjs",
    "test:p2": "node --test tests/p2/*.test.mjs",
    "test:p3": "node --test tests/p3/http-contract.test.mjs tests/p3/migration.test.mjs tests/p3/project-workflow.test.mjs",
    "test:p31": "node --test tests/p31/*.test.mjs",
    "test:p4": "node --test tests/p4/*.test.mjs",
    "test:p5": "node --test tests/p5/*.test.mjs",
    "test:p6": "node --test tests/p6/*.test.mjs",
    "test:p7": "node --test tests/p7/*.test.mjs",
    "test:p8": "node --test tests/p8/*.test.mjs",
    "test:p9": "node --test tests/p9/*.test.mjs",
    "test:p10": "node --test tests/p10/*.test.mjs",
    "audit:parity": "node scripts/v3-clean-p10-parity.mjs",
    "evidence:p3": "node scripts/v3-clean-p3-evidence.mjs",
    "evidence:p31": "node scripts/v3-clean-p31-evidence.mjs",
    "evidence:p4": "node scripts/v3-clean-p4-evidence.mjs",
    "evidence:p5": "node scripts/v3-clean-p5-evidence.mjs",
    "evidence:p6": "node scripts/v3-clean-p6-evidence.mjs",
    "evidence:p7": "node scripts/v3-clean-p7-evidence.mjs",
    "evidence:p8": "node scripts/v3-clean-p8-evidence.mjs",
    "evidence:p9": "node scripts/v3-clean-p9-evidence.mjs",
    "evidence:p10": "node scripts/v3-clean-p10-evidence.mjs",
    "test:integration:clean": "node scripts/layered-gate.mjs integration --clean",
    "test:security:clean": "node scripts/layered-gate.mjs security --clean",
    "fixture:legacy:integration": "node scripts/layered-gate.mjs integration --historical",
    "fixture:legacy:security": "node scripts/layered-gate.mjs security --historical",
    "fixture:legacy:e2e": "node scripts/e2e-legacy.mjs",
    "test:integration": "node scripts/layered-gate.mjs integration",
    "test:e2e": "node scripts/e2e.mjs",
    "test:security": "node scripts/layered-gate.mjs security",
    "test:release": "node --test tests/release/*.test.mjs",
    "test:runner-real": "node scripts/runner-real-smoke.mjs",
    "github:seed-fixture": "node scripts/github-seed-fixture.mjs",
    "verify:dev": "node scripts/verify-dev.mjs",
    "verify": "node scripts/verify.mjs",
    "development:receipt": "node scripts/development-receipt.mjs",
    "fixture:seed-demo": "node scripts/seed-demo.mjs",
    "archive:v23": "node scripts/archive-v23.mjs",
    "fixture:legacy:acceptance": "node scripts/acceptance.mjs",
    "fixture:legacy:release-build": "node scripts/release-build.mjs",
    "fixture:legacy:release-rehearse": "node scripts/release-rehearsal.mjs",
    "fixture:legacy:release-promote": "node scripts/release-promote.mjs",
    "recovery:plan": "node scripts/recovery-governance.mjs plan",
    "recovery:catalog": "node scripts/recovery-governance.mjs catalog",
    "recovery:coverage": "node scripts/recovery-governance.mjs coverage",
    "recovery:impact": "node scripts/recovery-governance.mjs impact"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.53.2"
  },
  "dependencies": {
    "@aiws/contracts": "workspace:*",
    "busboy": "1.6.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "minisearch": "7.1.2",
    "node-pty": "^1.1.0",
    "smol-toml": "1.7.0",
    "ws": "^8.21.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static",
      "node-pty"
    ]
  }
}
