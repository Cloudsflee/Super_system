  status            String
  cols              Int       @default(80)
  rows              Int       @default(24)
  reconnectTokenHash String   @map("reconnect_token_hash")
  outputPreview     String    @map("output_preview")
  outputTruncated   Boolean   @default(false) @map("output_truncated")
  artifactFileRefId String?   @map("artifact_file_ref_id")
  exitCode          Int?      @map("exit_code")
  exitSignal        String?   @map("exit_signal")
  errorCode         String?   @map("error_code")
