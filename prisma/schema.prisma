generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id
  displayName String   @map("display_name")
  email       String   @default("")
  role        String   @default("owner")
  authMode    String   @map("auth_mode")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")
  projects    Project[]

  @@map("users")
}

model Project {
  id                 String   @id
  title              String
  goal               String
  role               String   @default("")
  background         String   @default("")
  status             String
  workspaceRoot      String   @map("workspace_root")
  repoPath           String   @map("repo_path")
  currentWorkspaceId String   @map("current_workspace_id")
  settings           Json
  onboardingState    String   @default("confirmed") @map("onboarding_state")
  sourceMetadata     Json?    @map("source_metadata")
  managedWorkspaceState String @default("empty") @map("managed_workspace_state")
  githubAccountId    String?  @map("github_account_id")
  deletedAt          DateTime? @map("deleted_at")
  trashMetadata      Json?    @map("trash_metadata")
  createdByUserId    String   @map("created_by_user_id")
  createdBy          User     @relation(fields: [createdByUserId], references: [id])
  createdAt          DateTime @map("created_at")
  updatedAt          DateTime @map("updated_at")
  workspaces         Workspace[]
  workflows          Workflow[]

  @@map("projects")
}

model Workspace {
  id             String   @id
  projectId      String   @map("project_id")
  project        Project  @relation(fields: [projectId], references: [id])
  parentId       String?  @map("parent_workspace_id")
  workflowNodeId String?  @map("workflow_node_id")
  type           String
  title          String
  goal           String
  status         String
  currentDigestId String? @map("current_digest_id")
  openQuestions  Json    @map("open_questions")
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")

  @@map("workspaces")
}

model Workflow {
  id          String   @id
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id])
  workspaceId String   @map("workspace_id")
  title       String
  version     Int
  status      String
  graphJson   Json     @map("graph_json")
  generatedBy String   @map("generated_by")
  confirmedByUserId String? @map("confirmed_by_user_id")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  @@map("workflows")
}

model NodeContract {
  id                 String   @id
  nodeId             String   @map("node_id")
  version            Int
  nodeGoal           String   @map("node_goal")
  expectedInputs     Json     @map("expected_inputs")
  expectedOutputs    Json     @map("expected_outputs")
  acceptanceCriteria Json     @map("acceptance_criteria")
  requiredContext    Json     @map("required_context")
  allowedTools       Json     @map("allowed_tools")
  assetOutputTypes   String[] @map("asset_output_types")
  failurePolicy      Json     @map("failure_policy")
  reviewPolicy       Json     @map("review_policy")
  status             String
  confirmedByUserId  String?  @map("confirmed_by_user_id")
  createdAt          DateTime @map("created_at")
  updatedAt          DateTime @map("updated_at")

  @@map("node_contracts")
}

model TraceEvent {
  id          String   @id
  eventType   String   @map("event_type")
  actorType   String   @map("actor_type")
  actorId     String?  @map("actor_id")
  projectId   String?  @map("project_id")
  workspaceId String?  @map("workspace_id")
  nodeId      String?  @map("node_id")
  runId       String?  @map("run_id")
  summary     String
  data        Json
  occurredAt  DateTime @map("occurred_at")

  @@map("trace_events")
}

model Asset {
  id          String   @id
  projectId   String   @map("project_id")
  workspaceId String?  @map("workspace_id")
  nodeId      String?  @map("node_id")
  runId       String?  @map("run_id")
  assetType   String   @map("asset_type")
  title       String
  summary     String
  status      String
  evidenceRefs Json    @map("evidence_refs")
  currentVersionId String? @map("current_version_id")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  @@map("assets")
}


model ConnectedAccount {
  id                 String   @id
  userId             String   @map("user_id")
  provider           String
  providerAccountId  String   @map("provider_account_id")
  login              String
  displayName        String   @map("display_name")
  credentialRefId    String?  @map("credential_ref_id")
  scopes             String[]
  permissionsSummary Json     @map("permissions_summary")
  status             String
  createdAt          DateTime @map("created_at")
  updatedAt          DateTime @map("updated_at")

  @@map("connected_accounts")
}

model CredentialRef {
  id            String   @id
  ownerUserId   String   @map("owner_user_id")
  kind          String
  provider      String
  refName       String   @map("ref_name")
  encryptedValue String  @map("encrypted_value")
  scopes        String[]
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")

  @@map("credential_refs")
}

model WorkflowNode {
  id                String   @id
  workflowId        String   @map("workflow_id")
  workspaceId       String?  @map("workspace_id")
  type              String
  title             String
  goal              String
  status            String
  orderIndex        Int      @map("order_index")
  dependencies      Json
  currentContractId String?  @map("current_contract_id")
  templateOutputs   String[] @map("template_outputs")
  position          Json

  @@map("workflow_nodes")
}

model ContextPack {
  id                    String   @id
  sourceWorkspaceId     String   @map("source_workspace_id")
  receiverType          String   @map("receiver_type")
  receiverName          String   @map("receiver_name")
  purpose               String
  version               Int
  status                String
  contentJson           Json     @map("content_json")
  memoryManifest        Json     @map("memory_manifest")
  sufficiencyCheckId    String?  @map("sufficiency_check_id")
  contentFileRefId      String?  @map("content_file_ref_id")
  markdownFileRefId     String?  @map("markdown_file_ref_id")
  includedAssetVersions Json     @map("included_asset_versions")
  tokenEstimate         Int      @map("token_estimate")
  qualityCheck          Json     @map("quality_check")
  confirmedByUserId     String?  @map("confirmed_by_user_id")
  createdAt             DateTime @map("created_at")
  updatedAt             DateTime @map("updated_at")

  @@map("context_packs")
}

model ContextSufficiencyCheck {
  id                 String   @id
  projectId          String   @map("project_id")
  workspaceId        String?  @map("workspace_id")
  nodeId             String?  @map("node_id")
  targetType         String   @map("target_type")
  targetId           String?  @map("target_id")
  status             String
  missingSlots       Json     @map("missing_slots")
  conflicts          Json
  staleRefs          Json     @map("stale_refs")
  includedMemoryRefs Json     @map("included_memory_refs")
  excludedMemoryRefs Json     @map("excluded_memory_refs")
  tokenEstimate      Int      @map("token_estimate")
  tokenBudget        Int      @map("token_budget")
  createdAt          DateTime @map("created_at")

  @@map("context_sufficiency_checks")
}

model AssistSession {
  id                String   @id
  version           Int
  projectId         String   @map("project_id")
  workspaceId       String?  @map("workspace_id")
  nodeId            String?  @map("node_id")
  scopeType         String   @map("scope_type")
  scopeId           String   @map("scope_id")
  parentSessionId   String?  @map("parent_session_id")
  agentSessionId    String?  @map("agent_session_id")
  codexThreadId     String?  @map("codex_thread_id")
  legacyCodexThreadId String? @map("legacy_codex_thread_id")
  nativeThreadGeneration Int? @map("native_thread_generation")
  runtimeProfileId  String?  @map("runtime_profile_id")
  runtimeAffinityKey String? @map("runtime_affinity_key")
  activeChangeBatchId String? @map("active_change_batch_id")
  nativeGoalSnapshot Json?    @map("native_goal_snapshot")
  nativeGoalSyncedAt  DateTime? @map("native_goal_synced_at")
  viewContext       Json     @map("view_context")
  status            String
  error             String?
  createdByUserId   String   @map("created_by_user_id")
  createdAt         DateTime @map("created_at")
  updatedAt         DateTime @map("updated_at")

  @@map("assist_sessions")
}

model NodeRun {
  id                String   @id
  projectId         String   @map("project_id")
  workspaceId       String   @map("workspace_id")
  nodeId            String   @map("node_id")
  contextPackId     String   @map("context_pack_id")
  runner            String
  status            String
  summary           String
  resultJson        Json?    @map("result_json")
  rawOutputFileRefId String? @map("raw_output_file_ref_id")
  createdByUserId   String   @map("created_by_user_id")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime @map("created_at")
  updatedAt         DateTime @map("updated_at")

  @@map("node_runs")
}

model FileRef {
  id           String   @id
  kind         String
  absolutePath String   @map("absolute_path")
  relativePath String   @map("relative_path")
  sha256       String
  sizeBytes    Int      @map("size_bytes")
  contentType  String   @map("content_type")
  meta         Json
  createdAt    DateTime @map("created_at")

  @@map("file_refs")
}

model AssetVersion {
  id                String   @id
  assetId           String   @map("asset_id")
  version           Int
  title             String
  summary           String
  body              String
  evidenceRefs      Json     @map("evidence_refs")
  confirmedByUserId String?  @map("confirmed_by_user_id")
  createdAt         DateTime @map("created_at")

  @@map("asset_versions")
}

model DecisionRecord {
  id                String   @id
  projectId         String   @map("project_id")
  workspaceId       String?  @map("workspace_id")
  title             String
  summary           String
  rationale         String
  status            String
  evidenceRefs      Json     @map("evidence_refs")
  confirmedByUserId String?  @map("confirmed_by_user_id")
  createdAt         DateTime @map("created_at")
  updatedAt         DateTime @map("updated_at")

  @@map("decision_records")
}

model WorkspaceDigest {
  id                String   @id
  projectId         String   @map("project_id")
  workspaceId       String   @map("workspace_id")
  version           Int
  status            String
  summary           String
  body              String
  evidenceRefs      Json     @map("evidence_refs")
  previousDigestId  String?  @map("previous_digest_id")
  confirmedByUserId String?  @map("confirmed_by_user_id")
  createdAt         DateTime @map("created_at")
  updatedAt         DateTime @map("updated_at")

  @@map("workspace_digests")
}

model CodeChange {
  id                 String   @id
  projectId          String   @map("project_id")
  workspaceId        String?  @map("workspace_id")
  nodeId             String?  @map("node_id")
  runId              String?  @map("run_id")
  repoPath           String   @map("repo_path")
  baseBranch         String   @map("base_branch")
  workBranch         String   @map("work_branch")
  baseCommit         String   @map("base_commit")
  headCommit         String   @map("head_commit")
  status             String
  changedFiles       Json     @map("changed_files")
  diffFileRefId      String?  @map("diff_file_ref_id")
  testResults        Json     @map("test_results")
  commitMessage      String   @map("commit_message")
  prBodyFileRefId    String?  @map("pr_body_file_ref_id")
  prUrl              String   @map("pr_url")
  committedByUserId  String?  @map("committed_by_user_id")
  createdByUserId    String   @map("created_by_user_id")
  createdAt          DateTime @map("created_at")
  updatedAt          DateTime @map("updated_at")

  @@map("code_changes")
}

model ToolDefinition {
  id              String   @id
  name            String
  type            String
  description     String
  config          Json
  enabled         Boolean
  capabilities    String[]
  permissions     Json
  usageBoundary   String   @map("usage_boundary")
  healthStatus    String   @map("health_status")
  discoveredTools Json     @map("discovered_tools")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")

  @@map("tool_definitions")
}

model HumanReview {
  id          String   @id
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  action      String
  reviewerId  String   @map("reviewer_id")
  patch       Json
  createdAt   DateTime @map("created_at")

  @@map("human_reviews")
}

model SetupState {
  id          String    @id
  mode        String?
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @map("updated_at")

  @@map("setup_states")
}

model GitHubAppConfig {
  id         String   @id
  mode       String
  appId      String   @map("app_id")
  clientId   String   @map("client_id")
  slug       String
  status     String
  refs       Json
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime @map("created_at")
  updatedAt  DateTime @map("updated_at")

  @@map("github_app_configs")
}

model GitHubInstallation {
  id             String   @id
  installationId String   @map("installation_id")
  appId          String   @map("app_id")
  account        Json
  repositories   Json
  status         String
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")

  @@map("github_installations")
}

model RepositoryBinding {
  id             String   @id
  projectId      String   @map("project_id")
  installationId String   @map("installation_id")
  repositoryId   String   @map("repository_id")
  fullName       String   @map("full_name")
  remoteName     String   @map("remote_name")
  permissions    Json
  createdByUserId String  @map("created_by_user_id")
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")

  @@map("repository_bindings")
}

model CodexProfile {
  id           String   @id
  name         String
  kind         String
  provider     String
  providerName String?  @map("provider_name")
  baseUrl      String?  @map("base_url")
  wireApi      String   @default("responses") @map("wire_api")
  requiresOpenaiAuth Boolean @default(false) @map("requires_openai_auth")
  model        String
  reasoning    String
  webSearch    Boolean  @map("web_search")
  mcpServers   Json     @map("mcp_servers")
  timeoutMs    Int      @map("timeout_ms")
  mounts       Json
  codexHome    String   @map("codex_home")
  configFile   String   @map("config_file")
  ccSwitchRequired Boolean @default(false) @map("cc_switch_required")
  ccSwitchProviderId String? @map("cc_switch_provider_id")
  ccSwitchStatus String @default("not_required") @map("cc_switch_status")
  ccSwitchSyncedAt DateTime? @map("cc_switch_synced_at")
  ccSwitchBridgeRevision Int? @map("cc_switch_bridge_revision")
  ccSwitchSourceCommit String? @map("cc_switch_source_commit")
  ccSwitchLastSwitchedAt DateTime? @map("cc_switch_last_switched_at")
  ccSwitchBindingType String? @map("cc_switch_binding_type")
  ccSwitchDiscoveryRevision String? @map("cc_switch_discovery_revision")
  discoverySource Json? @map("discovery_source")
  credentialConfigured Boolean @default(false) @map("credential_configured")
  assistConfiguration Boolean @default(false) @map("assist_configuration")
  baseProfileId String? @map("base_profile_id")
  modelCatalog Json? @map("model_catalog")
  modelCatalogUpdatedAt DateTime? @map("model_catalog_updated_at")
  modelCatalogRequired Boolean @default(false) @map("model_catalog_required")
  status       String
  isActive     Boolean  @map("is_active")
  createdAt    DateTime @map("created_at")
  updatedAt    DateTime @map("updated_at")

  @@map("codex_profiles")
}

model AgentSession {
  id              String   @id
  projectId       String   @map("project_id")
  workspaceId     String?  @map("workspace_id")
  scopeType       String   @map("scope_type")
  scopeId         String   @map("scope_id")
  parentSessionId String?  @map("parent_session_id")
  conversationKey String  @map("conversation_key")
  title           String
  status          String
  createdByUserId String  @map("created_by_user_id")
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")

  @@map("agent_sessions")
}

model AssistMessage {
  id        String   @id
  sessionId String   @map("session_id")
  role      String
  content   String
  status    String
  createdAt DateTime @map("created_at")

  @@map("assist_messages")
}

model AssistStreamEvent {
  sessionId String   @map("session_id")
  sequence  Int
  type      String
  data      Json
  createdAt DateTime @map("created_at")

  @@id([sessionId, sequence])
  @@map("assist_events")
}

model UIActionIntent {
  id              String   @id
  sessionId       String   @map("session_id")
  sourceMessageId String   @map("source_message_id")
  projectId       String   @map("project_id")
  workspaceId     String?  @map("workspace_id")
  nodeId          String?  @map("node_id")
  name            String
  label           String
  args            Json
  risk            String
  status          String
  result          Json?
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")

  @@map("ui_action_intents")
}

model ChangeProposal {
  id          String   @id
  projectId   String?  @map("project_id")
  workspaceId String?  @map("workspace_id")
  nodeId      String?  @map("node_id")
  changeType  String   @map("change_type")
  title       String
  summary     String
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  impact      Json
  risks       Json
  status      String
  attentionState String @default("queued") @map("attention_state")
  revision    Int      @default(1)
  targetHash  String?  @map("target_hash")
  applyAction Json?    @map("apply_action")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  @@map("change_proposals")
}

model FileChangeRecord {
  id           String   @id
  projectId    String   @map("project_id")
  workspaceId  String?  @map("workspace_id")
  nodeId       String?  @map("node_id")
  path         String
  beforeSha256 String   @map("before_sha256")
  afterSha256  String   @map("after_sha256")
  bytes        Int
  diff         Json
  source       String
  createdByUserId String @map("created_by_user_id")
  createdAt    DateTime @map("created_at")

  @@map("file_changes")
}

model NodeWorkspaceData {
  id          String   @id
  projectId   String   @map("project_id")
  workspaceId String   @map("workspace_id")
  nodeId      String   @map("node_id")
  data        Json
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  @@map("node_workspace_data")
}

model WebhookDelivery {
  deliveryId String   @id @map("delivery_id")
  event      String
  receivedAt DateTime @map("received_at")

  @@map("webhook_deliveries")
}

model TestTask {
  id          String   @id
  projectId   String   @map("project_id")
  workspaceId String?  @map("workspace_id")
  nodeId      String?  @map("node_id")
  preset      String
  command     String
  status      String
  stdout      String
  stderr      String
  durationMs  Int      @map("duration_ms")
  createdAt   DateTime @map("created_at")
  completedAt DateTime @map("completed_at")

  @@map("test_tasks")
}

model ProjectIntake {
  id              String   @id
  projectId       String   @map("project_id")
  mode            String?
  status          String
  answers         Json
  codeSource      Json?    @map("code_source")
  contextSources  Json     @map("context_sources")
  operationKey    String?  @map("operation_key")
  lastError       String?  @map("last_error")
  revision        Int      @default(1)
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")

  @@index([projectId])
  @@map("project_intakes")
}

model ProjectBrief {
  id                String    @id
  projectId         String    @map("project_id")
  version           Int
  status            String
  content           Json
  source            String
  confirmedByUserId String?   @map("confirmed_by_user_id")
  confirmedAt       DateTime? @map("confirmed_at")
  createdByUserId   String    @map("created_by_user_id")
  createdAt         DateTime  @map("created_at")
  updatedAt         DateTime  @map("updated_at")

  @@unique([projectId, version])
  @@map("project_briefs")
}

model AssistTurn {
  id                  String    @id
  sessionId           String    @map("session_id")
  projectId           String    @map("project_id")
  mode                String
  collaborationMode   String?   @map("collaboration_mode")
  status              String
  workspaceId         String?   @map("workspace_id")
  nodeId              String?   @map("node_id")
  parentTurnId        String?   @map("parent_turn_id")
  retryOfTurnId       String?   @map("retry_of_turn_id")
  followUpKind        String?   @map("follow_up_kind")
  prompt              String
  outputText          String    @map("output_text")
  profileId           String?   @map("profile_id")
  configurationId     String?   @map("configuration_id")
  model               String?
  reasoning           String?
  codexThreadId       String?   @map("codex_thread_id")
  worktreeId          String?   @map("worktree_id")
  changeBatchId       String?   @map("change_batch_id")
  viewContext         Json?     @map("view_context")
  codeAccess          String?   @map("code_access")
  codeReadOnlyReason  String?   @map("code_read_only_reason")
  contextPackId       String?   @map("context_pack_id")
  attachmentIds       Json      @map("attachment_ids")
  usage               Json?
  reviewStatus        String    @map("review_status")
  review              Json
  waitingApprovalId   String?   @map("waiting_approval_id")
  waitingUserInputId  String?   @map("waiting_user_input_id")
  errorCode           String?   @map("error_code")
  startedAt           DateTime? @map("started_at")
  completedAt         DateTime? @map("completed_at")
  createdByUserId     String    @map("created_by_user_id")
  createdAt           DateTime  @map("created_at")
  updatedAt           DateTime  @map("updated_at")

  @@index([sessionId, createdAt])
  @@index([projectId, status])
  @@map("assist_turns")
}

model Attachment {
  id              String    @id
  projectId       String    @map("project_id")
  sessionId       String?   @map("session_id")
  turnId          String?   @map("turn_id")
  kind            String
  title           String?
  label           String?
  fileRefId       String?   @map("file_ref_id")
  relativePath    String?   @map("relative_path")
  managedPath     String?   @map("managed_path")
  url             String?
  contentType     String?   @map("content_type")
  sizeBytes       Int       @default(0) @map("size_bytes")
  sha256          String?
  text            String?
  selection       Json?
  modelPolicy     String?   @map("model_policy")
  modelInjectable Boolean?  @map("model_injectable")
  status          String
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @map("created_at")
  updatedAt       DateTime? @map("updated_at")

  @@index([projectId, createdAt])
  @@index([turnId])
  @@map("attachments")
}

model Worktree {
  id             String    @id
  projectId      String    @map("project_id")
  turnId         String?   @map("turn_id")
  kind           String
  repoPath       String    @map("repo_path")
  path           String
  baseCommit     String    @map("base_commit")
  headCommit     String    @map("head_commit")
  status         String
  dirtyBaseline  Boolean   @default(false) @map("dirty_baseline")
  targetHash     String?   @map("target_hash")
  appliedTargetHash String? @map("applied_target_hash")
  appliedAt      DateTime? @map("applied_at")
  rolledBackAt   DateTime? @map("rolled_back_at")
  createdAt      DateTime  @map("created_at")
  updatedAt      DateTime  @map("updated_at")
  removedAt      DateTime? @map("removed_at")

  @@index([projectId, status])
  @@unique([turnId])
  @@map("worktrees")
}

model RuntimeApproval {
  id              String    @id
  projectId       String    @map("project_id")
  sessionId       String    @map("session_id")
  turnId          String    @map("turn_id")
  approvalType    String    @map("approval_type")
  attentionState  String    @default("interrupting") @map("attention_state")
  status          String
  revision        Int       @default(1)
  targetHash      String    @map("target_hash")
  request         Json
  decision        Json?
  externalId      String?   @map("external_id")
  decisionReason  String?   @map("decision_reason")
  decidedByUserId String?   @map("decided_by_user_id")
  decidedAt       DateTime? @map("decided_at")
  createdAt       DateTime  @map("created_at")
  updatedAt       DateTime  @map("updated_at")

  @@index([projectId, attentionState, status])
  @@index([turnId])
  @@map("runtime_approvals")
}

model TerminalSession {
